# Base URLs for the two backend services, plus the MinIO/S3-compatible
# storage endpoint for static UI art. Defaults already match local dev via
# DotCard-API's docker-compose, so this file is only needed if you're
# pointing at something else.
VITE_DOTCARD_API_URL=http://localhost:3001
VITE_AUTHFORGE_URL=http://localhost:3000
VITE_STORAGE_PUBLIC_URL=http://localhost:9000
